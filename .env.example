# Ollama exposes an OpenAI-compatible API. Replace the host when running
# Ollama outside WSL or on another computer.
OPENAI_BASE_URL=http://WINDOWS_HOST_IP:11434/v1
OPENAI_API_KEY=ollama
OLLAMA_BASE_URL=http://WINDOWS_HOST_IP:11434/v1
OLLAMA_API_KEY=ollama

# Formal experiment defaults.
FLE_SPECIFICITY_LEVEL=1
FLE_TRAJECTORY_LENGTH=150

